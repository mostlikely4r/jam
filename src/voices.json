  "pip": {
    "lines": {
      "approach": ["Coming in! Got a full hold!", "It's Pip! Requesting a berth!", "Nearly there! Don't close up!"],
      "heading_back": ["Full hold! Heading in!", "Haul's done! Coming home!", "That's the lot! Turning round!"],
