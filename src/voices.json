  "gus": {
    "lines": {
      "approach": ["Dock, Gus. Room for one more?", "Full hold coming in. Open the door.", "This is Gus. Same berth as always."],
      "heading_back": ["Load's in. Coming home.", "Full hold. Don't get excited.", "That's enough rock for one day."],
      "outbound": ["Back out. Same rocks, same dust.", "Empty again. Off I go.", "Field's still there, worse luck."],
      "all_clear": ["Pirate's gone. Back to work.", "Coast's clear. Wasting daylight."],
      "fleeing": ["Pirate. I'm too old for this.", "Running. Don't laugh.", "Bugging out. Cover me."],
      "mayday": ["Mayday. He's on me. Again.", "Mayday, mayday. Someone put a hole in my hull."],
      "thanks": ["That's my rock. Thanks.", "Owe you one, kid.", "Didn't see that. Won't say it twice."],
      "bought": ["Fitted a {part}. Feels wrong.", "New {part}. Cost me.", "They saw me coming on this {part}."],
      "field": ["Rocks don't get easier.", "Quiet. Good.", "Forty years of this.", "Anyone else hear that? No. Never mind."],
      "slim": ["Barren out here.", "Nothing but dust.", "Picked this corner clean."],
