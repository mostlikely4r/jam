      "all_clear": ["It's gone! Back to work!", "All clear! Phew!"],
      "fleeing": ["Pirate! Running!", "Eek, pirate! Bugging out!", "Not today! Going home!"],
      "mayday": ["Mayday! He's right behind me!", "Mayday mayday! Help!"],
      "thanks": ["Thanks! That's so many rocks!", "You're the best! Thank you!", "Owe you one!"],
      "bought": ["Look at my new {part}!", "I got a {part}! It's shiny!", "Fitted a {part}! Feels fast!"],
      "field": ["So many rocks!", "This is the good bit!", "One day I'll find the big one.", "Hello, rocks!"],
      "slim": ["Aww, nothing left here.", "This corner's picked clean.", "Where'd all the rock go?"],
      "news": ["Psst! {item} at {base}, {price}!", "Guess what: {base} has {item} for {price}!"]
